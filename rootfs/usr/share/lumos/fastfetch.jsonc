{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/lumos/logo.txt",
        "color": { "1": "yellow", "2": "white" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "yellow" }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "Grimoire" },
        { "type": "command", "key": "Maison", "text": "m=$(cat \"${XDG_CONFIG_HOME:-$HOME/.config}/lumos/maison\" 2>/dev/null) && echo \"${m^}\" || echo 'pas encore réparti'" },
        { "type": "kernel", "key": "Noyau" },
        { "type": "uptime", "key": "Éveillé depuis" },
        { "type": "packages", "key": "Sortilèges" },
        { "type": "shell", "key": "Baguette" },
        { "type": "de", "key": "Salle commune" },
        { "type": "terminal", "key": "Parchemin" },
        { "type": "cpu", "key": "Esprit" },
        { "type": "gpu", "key": "Œil" },
        { "type": "memory", "key": "Pensine" },
        { "type": "disk", "key": "Coffre" },
        "break",
        "colors"
    ]
}
